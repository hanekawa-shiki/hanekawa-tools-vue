{
  "name": "hanekawa-tools-vue",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "homepage": "https://github.com/hanekawa-shiki/hanekawa-tools-vue",
  "engines": {
    "node": ">=24",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "start": "vite",
    "build:all": "pnpm run build:cf & pnpm run build:gh",
    "build:cf": "vue-tsc -b && vite build --mode cf",
    "build:gh": "vue-tsc -b && vite build --mode gh",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"**/*.{ts,vue}\"",
    "test": "pnpm exec lint-staged",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.2.3",
    "@hugeicons/vue": "1.0.7",
    "@vueuse/core": "14.4.0",
    "axios": "1.19.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.21",
    "fuse.js": "7.5.0",
    "lunisolar": "2.6.0",
    "mime-db": "1.54.0",
    "parse-torrent": "11.0.24",
    "pdf-lib": "1.17.1",
    "reka-ui": "2.10.1",
    "tailwind-merge": "3.6.0",
    "vue": "3.5.40",
    "vue-router": "5.2.0",
    "vue-sonner": "2.0.9"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.2",
    "@types/parse-torrent": "5.8.8",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "10.8.0",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-tailwindcss": "4.2.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "lxgw-wenkai-webfont": "1.7.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "~6.0.3",
    "vite": "8.2.0",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-node-polyfills": "0.28.0",
    "vite-plugin-pwa": "1.3.0",
    "vue-tsc": "3.3.9",
    "workbox-window": "7.4.1"
  },
  "lint-staged": {
    "*.{js,mjs,ts,vue,json}": [
      "eslint --fix"
    ],
    "*.{ts,vue,js,mjs,json,css,html,md}": [
      "prettier --write"
    ]
  }
}
