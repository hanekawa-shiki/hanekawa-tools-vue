{
  "name": "hanekawa-tools-vue",
  "type": "module",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "homepage": "https://github.com/hanekawa-shiki/hanekawa-tools-vue",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "ignore"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "start": "vp dev",
    "build:all": "pnpm run build:cf & pnpm run build:gh",
    "build:cf": "vue-tsc -b && vp build --mode cf",
    "build:gh": "vue-tsc -b && vp build --mode gh",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt \"**/*.{ts,vue}\"",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vp preview",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/vue": "1.0.8",
    "@vueuse/core": "15.0.0",
    "axios": "1.21.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "fuse.js": "7.5.0",
    "lunisolar": "2.6.0",
    "mime-db": "1.54.0",
    "parse-torrent": "11.0.24",
    "pdf-lib": "1.17.1",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "vue-sonner": "2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/parse-torrent": "11.0.1",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-tailwindcss": "4.4.0",
    "lxgw-wenkai-webfont": "1.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "~6.0.3",
    "vite": "catalog:",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-node-polyfills": "0.28.0",
    "vite-plugin-pwa": "2.0.0",
    "vite-plus": "catalog:",
    "vue-tsc": "3.3.13",
    "workbox-window": "7.4.1"
  }
}
